# Core model providers (configure one or more)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
XAI_API_KEY=
XAI_MODEL=grok-4.6
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# ia.gratis resilience provider (server-only token; never expose it to the browser)
IA_GRATIS_API_TOKEN=
IA_GRATIS_API_BASE=https://ia.gratis/api/tools
IA_GRATIS_CHAT_MODEL=
IA_GRATIS_TIMEOUT_MS=22000

# Tool Fabric
TAVILY_API_KEY=
GITHUB_TOKEN=
DEFAULT_GITHUB_REPO=aleexwae4-lab/Inteligenciauniversal

# Enterprise Intelligence Fabric v90 — server-only authorized integrations.
# Leave blank unless the account/resource owner has explicitly granted access.
TESLA_FLEET_CLIENT_ID=
TESLA_FLEET_CLIENT_SECRET=
MICROSOFT_GRAPH_TENANT_ID=
MICROSOFT_GRAPH_CLIENT_ID=
MICROSOFT_GRAPH_CLIENT_SECRET=
NVIDIA_API_KEY=
NVIDIA_NIM_BASE_URL=

# WAE Universal Knowledge Fabric
# Contact identity is recommended by Crossref/OpenAlex/Open Library and NCBI tooling.
WAE_CONTACT_EMAIL=
NCBI_API_KEY=
WAE_KNOWLEDGE_RATE_LIMIT_PER_MINUTE=18
WAE_KNOWLEDGE_CACHE_TTL_MS=120000

# Persistent memory / distributed runtime control
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only. v74 prefers this credential for internal RPCs. Never expose it to clients.
SUPABASE_SERVICE_ROLE_KEY=
WAE_RUNTIME_BRIDGE_TOKEN=

# Runtime guardrails
WAE_ALLOWED_ORIGINS=
WAE_RATE_LIMIT_PER_MINUTE=30
WAE_IP_RATE_LIMIT_PER_MINUTE=1200
WAE_TASK_RATE_LIMIT_PER_MINUTE=12
WAE_MAX_CONCURRENT_CHAT=48
WAE_DISTRIBUTED_RATE_PER_MINUTE=30
WAE_DISTRIBUTED_CHAT_CONCURRENCY_TARGET=512
WAE_DISTRIBUTED_LEASE_SECONDS=45
WAE_ROUTER_PERSISTENT_TTL_MS=30000
WAE_RUNTIME_BRIDGE_TIMEOUT_MS=900
WAE_RUNTIME_OBSERVE_TIMEOUT_MS=450
WAE_DISTRIBUTED_ADMISSION_FAIL_CLOSED=0
PUBLIC_APP_URL=

# Universal Core Backend v73
WAE_V73_MAX_BODY_BYTES=2000000
WAE_V73_REQUEST_TIMEOUT_MS=45000
WAE_V73_RATE_LIMIT_PER_MINUTE=120
WAE_V73_METRICS_WINDOW=512
WAE_V73_EXPOSE_DIAGNOSTICS=0
WAE_ADMIN_API_KEY=
WAE_TRUST_PROXY=1

# Universal Core Enterprise Control Plane v74
# observe: never reject tenant mismatch; authenticated: bind authenticated tenant claims; strict: tenant claims require authentication.
WAE_V74_TENANT_ENFORCEMENT=authenticated
